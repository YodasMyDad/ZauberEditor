<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AssemblyName>ZauberCMS.RTE</AssemblyName>
    <RootNamespace>ZauberCMS.RTE</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ZauberCMS.RTE</PackageId>
    <Version>3.1.0</Version>
    <Authors>Lee Messenger</Authors>
    <Description>A modern, extensible rich-text editor component for Blazor applications</Description>
    <PackageTags>blazor;richtext;editor;wysiwyg;html</PackageTags>
    <RepositoryUrl>https://github.com/YodasMyDad/ZauberEditor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/YodasMyDad/ZauberEditor</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <Content Remove="package.json;package-lock.json" />
    <None Remove="package.json;package-lock.json" />
    <InternalsVisibleTo Include="ZauberCMS.RTE.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
