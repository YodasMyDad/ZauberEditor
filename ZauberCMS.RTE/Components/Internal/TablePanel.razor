@inherits PanelBase

<form class="rte-panel-content" @onsubmit="InsertAsync" @onsubmit:preventDefault>
    <div class="rte-form-group">
        <label for="@ElementId("rows")" class="rte-label">Rows</label>
        <input id="@ElementId("rows")" type="number" class="rte-input" min="1" max="@MaxSize" @bind="_rows" />
    </div>

    <div class="rte-form-group">
        <label for="@ElementId("columns")" class="rte-label">Columns</label>
        <input id="@ElementId("columns")" type="number" class="rte-input" min="1" max="@MaxSize" @bind="_columns" />
    </div>

    <div class="rte-form-group">
        <label class="rte-checkbox-label">
            <input type="checkbox" @bind="_hasHeader" />
            Include a header row
        </label>
    </div>

    <div class="rte-panel-actions">
        <button type="button" class="rte-btn rte-btn-secondary" @onclick="CloseAsync">Cancel</button>
        <button type="submit" class="rte-btn rte-btn-primary">Insert table</button>
    </div>
</form>
