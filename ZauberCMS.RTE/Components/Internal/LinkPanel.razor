@inherits PanelBase

<form class="rte-panel-content" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <div class="rte-form-group">
        <label for="@ElementId("url")" class="rte-label">URL</label>
        <input id="@ElementId("url")"
               type="text"
               inputmode="url"
               autocomplete="off"
               class="rte-input"
               placeholder="https://example.com"
               aria-invalid="@(_error is null ? null : "true")"
               @bind="_url"
               @bind:event="oninput" />
        @if (_error is not null)
        {
            <p class="rte-form-error" role="alert">@_error</p>
        }
    </div>

    <div class="rte-form-group">
        <label for="@ElementId("text")" class="rte-label">Text to display</label>
        <input id="@ElementId("text")" type="text" class="rte-input" placeholder="Link text" @bind="_text" @bind:event="oninput" />
    </div>

    <div class="rte-form-group">
        <label for="@ElementId("title")" class="rte-label">Title</label>
        <input id="@ElementId("title")" type="text" class="rte-input" placeholder="Optional" @bind="_title" @bind:event="oninput" />
    </div>

    <div class="rte-form-group">
        <label for="@ElementId("target")" class="rte-label">Open link in</label>
        <select id="@ElementId("target")" class="rte-select" @bind="_target">
            <option value="">Current window</option>
            <option value="_blank">New window</option>
        </select>
    </div>

    <div class="rte-panel-actions">
        <button type="button" class="rte-btn rte-btn-secondary" @onclick="CloseAsync">Cancel</button>
        <button type="submit" class="rte-btn rte-btn-primary" disabled="@string.IsNullOrWhiteSpace(_url)">Save</button>
    </div>
</form>
