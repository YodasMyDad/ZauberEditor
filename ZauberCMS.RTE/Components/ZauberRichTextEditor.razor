<div @ref="_root" @attributes="AdditionalAttributes" class="@RootClass" style="@RootStyle">
    <CascadingValue Value="_arrangement">
        <EditorToolbar @ref="_toolbar"
                       State="_state"
                       AriaLabel="@($"{AriaLabel} toolbar")"
                       ContentId="@_contentId"
                       OnExecute="ExecuteItemAsync" />
    </CascadingValue>

    <div class="rte-editor-container">
        <div @ref="_content"
             id="@_contentId"
             class="rte-content"
             contenteditable="@(ReadOnly ? "false" : "true")"
             role="textbox"
             aria-multiline="true"
             aria-label="@AriaLabel"
             aria-readonly="@ToolbarPresenter.Bool(ReadOnly)"
             data-placeholder="@Placeholder"
             hidden="@_state.IsSourceView"></div>
        <textarea @ref="_source"
                  class="rte-source-view"
                  aria-label="HTML source"
                  spellcheck="false"
                  readonly="@ReadOnly"
                  hidden="@(!_state.IsSourceView)"></textarea>
    </div>

    <div class="rte-editor-resize-handle" aria-hidden="true"></div>

    <ToastRegion @ref="_toasts" />

    <SlideOutPanel @ref="_panel"
                   Api="Api"
                   ThemeClass="@ThemeClass"
                   Content="_panelRequest?.Content"
                   Title="@_panelTitle"
                   OnClose="ClosePanelFromUserAsync" />
</div>
