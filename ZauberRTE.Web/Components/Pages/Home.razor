@page "/"
@rendermode InteractiveServer

<PageTitle>Full toolbar</PageTitle>

<h1>Full toolbar</h1>
<p class="lead-text">
    Every built-in item (<code>ToolbarLayout.Full</code>) with <code>@@bind-Value</code>. The bound value is shown as
    escaped text and rendered in a sandboxed iframe; the editor's events are logged on the right. Press
    <kbd>Ctrl</kbd>+<kbd>S</kbd> in the editor to run a <code>Shortcuts</code> handler that saves without a toolbar
    button. The <code>HtmlPolicy</code> allows <code>target</code> only on links, through <code>TagAttributes</code>.
</p>

<ZauberRichTextEditor @bind-Value="_html"
                      Toolbar="ToolbarLayout.Full"
                      Settings="UploadSettings"
                      Placeholder="Start writing…"
                      Shortcuts="Shortcuts"
                      OnChange="LogChange"
                      OnStateChanged="ShowState"
                      OnCommandFailed="ShowFailure" />

<p class="editor-status" role="status">
    <span class="word-count">@_state.WordCount words · @_state.CharacterCount characters</span>
    <span class="save-status">@_saveStatus</span>
</p>

<div class="demo-grid inspector">
    <div>
        <HtmlSource Html="@_html" />
        <HtmlPreview Html="@_html" />
    </div>
    <div>
        <h2 class="panel-heading">OnStateChanged</h2>
        <dl class="state-summary">
            @foreach (var (name, value) in StateRows)
            {
                <div @key="name">
                    <dt>@name</dt>
                    <dd>@value</dd>
                </div>
            }
        </dl>

        <h2 class="panel-heading">OnChange</h2>
        <ol class="change-log" aria-live="polite">
            @foreach (var change in _changes)
            {
                <li @key="change.Number">#@change.Number <strong>@change.Source</strong> · @change.Size</li>
            }
        </ol>
    </div>
</div>

<section class="demo-section">
    <h2>EditForm validation</h2>
    <p class="lead-text">
        <code>@@bind-Value</code> also passes <code>ValueExpression</code>, so the editor notifies the
        <code>EditContext</code>. Clear the text and press Save to see the required-content message.
    </p>
    <ArticleForm />
</section>
