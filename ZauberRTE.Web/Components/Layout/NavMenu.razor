<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Zauber RTE</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Demos">
        @foreach (var link in Links)
        {
            <div @key="link.Href" class="nav-item px-3">
                <NavLink class="nav-link" href="@link.Href" Match="@(link.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @link.Title
                </NavLink>
            </div>
        }
    </nav>
</div>
